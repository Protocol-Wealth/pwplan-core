# Planning backend: "nexus-mcp" (open reference, nexus-core MCP) or
# "pw-api" (Protocol Wealth production, requests routed through pw-api).
VITE_PLANNING_BACKEND=nexus-mcp

# Gateway base URL.
#   nexus-mcp prod:  https://nexusmcp.site
#   pw-api    prod:  https://pw-api.<...>   (auth required)
VITE_PLANNING_GATEWAY_URL=http://localhost:8787

# Local UI dev only. Bypasses pwos-core compliance packages.
# MUST be unset/0 in production; CI fails the build otherwise.
VITE_COMPLIANCE_NOOP=0
