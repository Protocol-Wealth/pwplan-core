# Planning backend.
#   "nexus-mcp"  open reference — talks to the nexus-core MCP gateway. Use this.
#   "pw-api"     private-fork path only. This OSS repo never reaches pw-api; the
#                seam exists so the private fork is a low-diff sync. See README.
VITE_PLANNING_BACKEND=nexus-mcp

# Gateway base URL. Defaults (in code) to the public nexus-core MCP demo endpoint,
# so a fresh clone runs against the real engine with no .env at all.
#   public demo:   https://nexusmcp.site
#   local engine:  http://localhost:8787
VITE_PLANNING_GATEWAY_URL=https://nexusmcp.site
